# Environment files (NEVER commit secrets or credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# Dependencies
node_modules/
**/node_modules/

# Production build outputs
dist/
build/
**/dist/
**/build/

# Logs & Debugging
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test & Coverage
coverage/
**/coverage/

# OS and IDE files
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.swp
*.swo
